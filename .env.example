# Firebase Database URL
# The base URL of your Firebase Realtime Database
# Format: https://[PROJECT_ID].firebaseio.com (without trailing slash)
# Example: https://my-resume-1a1ca-default-rtdb.firebaseio.com
VITE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Privacy Configuration
# Set to 'true' to show private contact information (phone, location)
# Leave empty or set to 'false' to hide private information
VITE_SHOW_PRIVATE_INFO=false
